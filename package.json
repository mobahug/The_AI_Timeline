{
  "name": "the-ai-timeline",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "An investigation board of artificial intelligence: 1900 to 2050, with the strings between the events.",
  "scripts": {
    "dev": "vite",
    "build": "tsx scripts/gen-sitemap.ts && tsx scripts/gen-feed.ts && vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr && tsx scripts/prerender.ts",
    "build:client": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "tsc --noEmit && vitest run",
    "test:watch": "vitest",
    "fetch:images": "tsx scripts/fetch-images.ts",
    "check:links": "tsx scripts/check-links.ts",
    "check:quotes": "tsx --max-http-header-size=65536 scripts/check-quotes.ts",
    "gen:sitemap": "tsx scripts/gen-sitemap.ts",
    "gen:feed": "tsx scripts/gen-feed.ts"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "satori": "^0.51.0",
    "sharp": "^0.35.5",
    "tsx": "^4.23.13",
    "typescript": "~7.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.4",
    "wawoff2": "^2.0.1"
  },
  "license": "PolyForm-Noncommercial-1.0.0",
  "overrides": {
    "fflate": "^0.8.3"
  }
}
